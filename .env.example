# Copy to .env and fill in. Never commit .env.

# Required. The backend refuses to start without it (PRD FR-116, DEC-002).
# Server-side only: also set it in the Next.js server env (no NEXT_PUBLIC_ prefix) in Day 1B.
DEMO_RESET_TOKEN=change-me-to-a-long-random-string

# Optional. Defaults: backend/data/clearmatch.db and backend/storage/uploads.
# Relative paths resolve from the directory the command runs in (backend/).
# DATABASE_PATH=data/clearmatch.db
# UPLOADS_DIR=storage/uploads
FRONTEND_ORIGIN=http://localhost:3000

# LLM extraction (Day 2B). Put real keys only in backend/.env, never here.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
