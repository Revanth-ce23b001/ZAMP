# Copy to backend/.env and fill in. backend/.env is gitignored.
# NEVER put a real key in this file: it is committed to the repository.

# Required. The backend refuses to start without it (PRD FR-116, DEC-002).
# Server-side only: also set it in the Next.js server env (no NEXT_PUBLIC_ prefix).
DEMO_RESET_TOKEN=change-me-to-a-long-random-string

# Optional. Defaults: backend/data/clearmatch.db and backend/storage/uploads.
# Relative paths resolve from the directory the command runs in (backend/).
# DATABASE_PATH=data/clearmatch.db
# UPLOADS_DIR=storage/uploads
FRONTEND_ORIGIN=http://localhost:3000

# LLM extraction. A non-empty chain with credentials is required at startup (DEC-013).
# The single provider below is a chain of length one for both text and vision PDFs.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ordered fallback chains (DEC-013, DEC-017): provider:model, comma-separated, tried in order
# on 429/5xx/timeout/connection errors only (never on malformed output). When set they replace
# LLM_PROVIDER/LLM_MODEL. Free tier only: both entries use GEMINI_API_KEY, and each model has its
# own daily quota. The deployed backend sets these in Render; use a key from a SEPARATE Google
# project there, so local testing never spends the demo's quota.
# EXTRACTION_TEXT_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite
# EXTRACTION_VISION_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite
# Per-call provider timeout (default 120). Each model keeps one retry, so a hung model costs up to
# 2 x this before the next model is tried. Render uses 45.
# EXTRACTION_TIMEOUT_SECONDS=45

# FR-014 extraction cache: on (default) or off. DEC-014 snapshot: default
# backend/seed/extraction_cache.json, loaded only into an empty cache; "off" disables it.
# EXTRACTION_CACHE=on
# CACHE_SNAPSHOT=off
