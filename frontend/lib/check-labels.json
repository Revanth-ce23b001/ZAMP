    "vendor_status": { "name": "Vendor status", "group": "Vendor identity" },
    "bank_details_match": { "name": "Bank details match vendor master", "group": "Bank details" },
    "duplicate_search": { "name": "Duplicate search", "group": "Duplicate checks" },
    "duplicate_confirmed": { "name": "Same vendor and invoice number", "group": "Duplicate checks" },
    "duplicate_possible": { "name": "Same total, dates and lines", "group": "Duplicate checks" },
    "duplicate_revision": { "name": "Revision of an earlier invoice", "group": "Duplicate checks" },
    "duplicate_similar": { "name": "Similar invoice (note only)", "group": "Duplicate checks" },
    "po_lookup": { "name": "PO lookup", "group": "PO identification" },
