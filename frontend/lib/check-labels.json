    "arithmetic_E3 CGST": { "name": "CGST equals rate × taxable value (E3)", "group": "Arithmetic" },
    "arithmetic_E3 SGST": { "name": "SGST equals rate × taxable value (E3)", "group": "Arithmetic" },
    "arithmetic_E3 IGST": { "name": "IGST equals rate × taxable value (E3)", "group": "Arithmetic" },
    "arithmetic_E4": { "name": "Total reconciles (E4)", "group": "Arithmetic" },
    "document_supported": { "name": "Supported document type and currency", "group": "Document" },
