# Copy to .env.local. Server-only variables: never add a NEXT_PUBLIC_ prefix to either.

# Backend origin, read by server code only (reset route, policy page).
BACKEND_URL=http://localhost:8000

# Must equal the backend's DEMO_RESET_TOKEN. Added to the forwarded request by
# app/api/demo/reset/route.ts and never sent to the browser (PRD FR-116, DEC-002).
DEMO_RESET_TOKEN=change-me-to-the-same-value-as-the-backend
