# Copy to .env.local. Server-only variables: never add a NEXT_PUBLIC_ prefix to either.

# Backend origin, read by server code only (reset route, policy page).
BACKEND_URL=http://localhost:8000

# Backend origin used by the BROWSER (uploads, run data, the SSE live stream). Public, not a
# secret; inlined at build time. The browser connects to the backend directly because proxying
# an event stream through a serverless route buffers it. Set the backend's FRONTEND_ORIGIN to
# this app's origin so CORS allows it.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000

# Must equal the backend's DEMO_RESET_TOKEN. Added to the forwarded request by
# app/api/demo/reset/route.ts and never sent to the browser (PRD FR-116, DEC-002).
DEMO_RESET_TOKEN=change-me-to-the-same-value-as-the-backend
